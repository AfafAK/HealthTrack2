<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0F1E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingTop="48dp">
        <TextView android:text="Statistiques"
            android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="Vos données de santé"
            android:textColor="#66FFFFFF" android:textSize="13sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:paddingTop="0dp">

        <Button android:id="@+id/tabActivite"
            android:layout_width="0dp" android:layout_height="38dp"
            android:layout_weight="1" android:text="Activité"
            android:textSize="12sp" android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_primary"
            android:layout_marginEnd="4dp"/>

        <Button android:id="@+id/tabImc"
            android:layout_width="0dp" android:layout_height="38dp"
            android:layout_weight="1" android:text="IMC"
            android:textSize="12sp" android:textColor="#88FFFFFF"
            android:background="@drawable/bg_card"
            android:layout_marginHorizontal="2dp"/>

        <Button android:id="@+id/tabTension"
            android:layout_width="0dp" android:layout_height="38dp"
            android:layout_weight="1" android:text="Tension"
            android:textSize="12sp" android:textColor="#88FFFFFF"
            android:background="@drawable/bg_card"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingTop="0dp">

            <!-- Panel Activité -->
            <LinearLayout android:id="@+id/panelActivite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical" android:padding="20dp"
                    android:layout_marginBottom="12dp">
                    <TextView android:text="Pas cette semaine"
                        android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"
                        android:layout_marginBottom="12dp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/chartSteps"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical" android:padding="20dp"
                    android:layout_marginBottom="12dp">
                    <TextView android:text="Calories brûlées"
                        android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"
                        android:layout_marginBottom="12dp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/chartCalories"
                        android:layout_width="match_parent"
                        android:layout_height="130dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Panel IMC -->
            <LinearLayout android:id="@+id/panelImc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical" android:padding="20dp"
                    android:layout_marginBottom="12dp">
                    <TextView android:text="Évolution IMC (6 mois)"
                        android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"
                        android:layout_marginBottom="12dp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/chartImc"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Panel Tension -->
            <LinearLayout android:id="@+id/panelTension"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingBottom="100dp">
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical" android:padding="20dp">
                    <TextView android:text="Tension artérielle"
                        android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"
                        android:layout_marginBottom="12dp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/chartTension"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"/>
                    <LinearLayout android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginTop="8dp">
                        <TextView android:text="● Systolique"
                            android:textColor="#F87171" android:textSize="12sp"
                            android:layout_marginEnd="12dp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="● Diastolique"
                            android:textColor="#60A5FA" android:textSize="12sp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>