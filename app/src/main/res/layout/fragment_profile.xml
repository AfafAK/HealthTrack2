<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F1E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp"
            android:paddingTop="48dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:gravity="center"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_primary"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:id="@+id/tvProfileName"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="Profil santé"
                    android:textColor="#66FFFFFF"
                    android:textSize="13sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- IMC Live Card -->
            <LinearLayout
                android:id="@+id/cardImcProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_blue"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:text="VOTRE IMC"
                    android:textColor="#66FFFFFF"
                    android:textSize="11sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tvImcProfile"
                        android:text="--"
                        android:textColor="#FFFFFF"
                        android:textSize="48sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvImcCatProfile"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Form -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:text="Données de santé"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:text="POIDS (kg)"
                    android:textColor="#88FFFFFF"
                    android:textSize="11sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etPoids"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Ex: 75"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_input"
                    android:paddingHorizontal="16dp"
                    android:inputType="numberDecimal"
                    android:layout_marginBottom="14dp"/>

                <TextView
                    android:text="TAILLE (cm)"
                    android:textColor="#88FFFFFF"
                    android:textSize="11sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etTaille"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Ex: 175"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_input"
                    android:paddingHorizontal="16dp"
                    android:inputType="numberDecimal"
                    android:layout_marginBottom="14dp"/>

                <TextView
                    android:text="TENSION (ex: 120/80)"
                    android:textColor="#88FFFFFF"
                    android:textSize="11sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etTension"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Ex: 120/80 mmHg"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_input"
                    android:paddingHorizontal="16dp"
                    android:inputType="text"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btnSaveProfile"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Sauvegarder"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_btn_primary"/>

                <TextView
                    android:id="@+id/tvSaveSuccess"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✓ Données mises à jour !"
                    android:textColor="#4ADE80"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- IMC Scale -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:text="Échelle IMC"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:text="&lt; 18.5"
                        android:textColor="#CCFFFFFF"
                        android:textSize="13sp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <TextView
                        android:text="Insuffisance pondérale"
                        android:textColor="#60A5FA"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:text="18.5 – 24.9"
                        android:textColor="#CCFFFFFF"
                        android:textSize="13sp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <TextView
                        android:text="Normal ✓"
                        android:textColor="#4ADE80"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:text="25 – 29.9"
                        android:textColor="#CCFFFFFF"
                        android:textSize="13sp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <TextView
                        android:text="Surpoids"
                        android:textColor="#FBBF24"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:text="&gt; 30"
                        android:textColor="#CCFFFFFF"
                        android:textSize="13sp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <TextView
                        android:text="Obésité"
                        android:textColor="#F87171"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Logout -->
            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Se déconnecter"
                android:textSize="16sp"
                android:textColor="#F87171"
                android:background="@drawable/bg_btn_purple_outline"
                android:layout_marginBottom="100dp"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>